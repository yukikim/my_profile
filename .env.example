# Local development environment setting

DATABASE_URI=postgres://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment environment setting

# DATABASE_URI=postgresql://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DATABASE_URI_DIRECT=postgresql://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_SITE_URL=https://test-tk.net

# 任意。復元先に合わせたpg_dump・pg_restoreのディレクトリを指定します。
# DB Restore Target
TARGET_DATABASE_URI=postgresql://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payloadの署名・暗号化に使うため、本番では十分に長いランダム値へ置き換えます。
PAYLOAD_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TEMPLATE=profile

# seed用認証情報です。本番管理者の実パスワードはこのexampleへ記録しません。
# if you want to seed an admin user, set the following environment variables
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_NAME=Admin User

# 問い合わせ通知メールを有効にするときだけ設定します。
GMAIL_USER=hogefuga@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password

POSTGRES_BIN_DIR=/usr/local/opt/libpq@16/bin
